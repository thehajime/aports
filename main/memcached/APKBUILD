# Contributor: Jeff Bilyk <jbilyk@alpinelinux.org>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=memcached
pkgver=1.6.45
pkgrel=0
pkgdesc="Distributed memory object caching system"
url="https://memcached.org/"
arch="all"
license="BSD-3-Clause"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="$depends_dev cyrus-sasl-dev libevent-dev libseccomp-dev linux-headers bsd-compat-headers"
install="$pkgname.pre-install"
subpackages="$pkgname-dev $pkgname-doc $pkgname-openrc"
source="https://www.memcached.org/files/memcached-$pkgver.tar.gz
	$pkgname.confd
	$pkgname.initd
	memcached-nommu.pre-install
	fix-bsd-headers.patch
	"

if [ "${SVM_ONLY:-0}" = 1 ]; then
	pkgname="$pkgname-nommu"
	pkgdesc="$pkgdesc (instrumented SVM guest)"
	arch="x86_64"
	subpackages=""
	makedepends="libevent-nommu-dev linux-headers bsd-compat-headers"
	depends="musl-nommu libevent-nommu"
	options="$options !check !tracedeps"
	install="$pkgname.pre-install"
fi

# secfixes:
#   0:
#     - CVE-2022-26635

build() {
	if [ "${SVM_ONLY:-0}" = 1 ]; then
		. "$startdir/../../scripts/svm-profile.sh"
		svm_guest_profile || return 1
		local _svm_cc="$CC"
		PKG_CONFIG_LIBDIR="$SVM_SYSROOT/usr/lib/pkgconfig" \
		PKG_CONFIG_SYSROOT_DIR="$SVM_SYSROOT" \
		LDFLAGS="$LDFLAGS -L$SVM_SYSROOT/usr/lib" \
		CC="${REALGCC:-gcc}" ./configure \
			--build="$CBUILD" \
			--host=x86_64-linux-musl \
			--prefix=/usr \
			--disable-sasl \
			--disable-seccomp || return 1
		PKG_CONFIG_LIBDIR="$SVM_SYSROOT/usr/lib/pkgconfig" \
		PKG_CONFIG_SYSROOT_DIR="$SVM_SYSROOT" \
		LDFLAGS="$LDFLAGS -L$SVM_SYSROOT/usr/lib" \
		make CC="$_svm_cc"
		return
	fi
	CFLAGS="$CFLAGS -flto=auto -O2" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--enable-sasl \
		--enable-sasl-pwdb \
		--enable-seccomp
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -m755 -D "$srcdir/memcached.initd" \
		"$pkgdir/etc/init.d/memcached"
	install -m644 -D "$srcdir/memcached.confd" \
		"$pkgdir/etc/conf.d/memcached"
}

