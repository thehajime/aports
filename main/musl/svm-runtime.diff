+#define SVM_VA_BASE 0x1000000000UL
+#define SVM_VA_SPAN 0x40000000UL
+static inline unsigned long *svm_arch_root(void)
+{
+	unsigned long *root;
+	__asm__("mov %%fs:200,%0" : "=r"(root));
+	return root;
+}
+static inline void *svm_arch_clone_stack(void *stack)
+{
+	unsigned long top = (unsigned long)stack & -16UL;
+	return (char *)__sv_virt2phys_internal((void *)(top - 16), 16) + 16;
+}
