+/* SVM translation and startup must be built without the compiler plugin. */
+#ifdef SVM_RUNTIME
+#include <stddef.h>
+#include <stdint.h>
+#include <errno.h>
+#include "pthread_impl.h"
+#include "syscall.h"
+#include "svm_runtime.h"
+#include "svm_arch.h"
+
+#define PR_SVM_INSTALL_L1_TLS 0x53764d03
+#define PR_SVM_PHYS2VIRT 0x53764d02
+
+_Static_assert(sizeof(struct pthread) == 208, "SVM ELF note TCB size");
+_Static_assert(offsetof(struct pthread, svm_root) == 200, "SVM root offset");
+
+__asm__(".pushsection .note.svm,\"a\",@note\n"
+        ".balign 4\n.long 4,8,1\n.asciz \"SVM\"\n"
+        ".balign 4\n.long 2,208\n.popsection\n");
+
+static int runtime_ready;
+
+void __svm_start_runtime(void)
+{
+	if (__syscall(SYS_prctl, PR_SVM_INSTALL_L1_TLS,
+	    offsetof(struct pthread, svm_root), 0, 0, 0)) a_crash();
+	__atomic_store_n(&runtime_ready, 1, __ATOMIC_RELEASE);
+}
+
+void *__sv_virt2phys_internal(const void *pointer, size_t size)
+{
+	uintptr_t va = (uintptr_t)pointer, pa, entry, *leaf;
+	unsigned long *root;
+	size_t n;
+
+	if (va < SVM_VA_BASE || va - SVM_VA_BASE >= SVM_VA_SPAN)
+		return (void *)pointer;
+	if (!__atomic_load_n(&runtime_ready, __ATOMIC_ACQUIRE)) a_crash();
+	if (!size) size = 1;
+	if (size > SVM_VA_SPAN - (va - SVM_VA_BASE)) a_crash();
+	root = svm_arch_root();
+	if (!root) a_crash();
+	entry = __atomic_load_n(root + ((va >> 21) & 511), __ATOMIC_ACQUIRE);
+	if (!(entry & 1)) a_crash();
+	leaf = (uintptr_t *)(entry & -4096UL);
+	entry = __atomic_load_n(leaf + ((va >> 12) & 511), __ATOMIC_RELAXED);
+	if (!(entry & 1)) a_crash();
+	pa = (entry & -4096UL) | (va & 4095);
+	/* Scalar accesses spanning pages require contiguous physical backing. */
+	for (n = 4096 - (va & 4095); n < size; n += 4096) {
+		uintptr_t next = va + n;
+		entry = __atomic_load_n(root + ((next >> 21) & 511), __ATOMIC_ACQUIRE);
+		if (!(entry & 1)) a_crash();
+		leaf = (uintptr_t *)(entry & -4096UL);
+		entry = __atomic_load_n(leaf + ((next >> 12) & 511), __ATOMIC_RELAXED);
+		if (!(entry & 1) || (entry & -4096UL) != pa + n) a_crash();
+	}
+	return (void *)pa;
+}
+
+void *sv_virt2phys(const void *p, size_t n)
+{
+	return __sv_virt2phys_internal(p, n);
+}
+
+void *__sv_phys2virt_local(const void *p, size_t n)
+{
+	unsigned long va;
+	long ret;
+	/* Loader/stack/native data retain PA identity in the current UML lane. */
+	if (!__atomic_load_n(&runtime_ready, __ATOMIC_ACQUIRE)) return (void *)p;
+	ret = __syscall(SYS_prctl, PR_SVM_PHYS2VIRT, p, n, &va, 0);
+	if (ret == -ENOENT) return (void *)p;
+	if (ret) a_crash();
+	return (void *)va;
+}
+
+void *sv_phys2virt(const void *p, size_t n)
+{
+	return __sv_phys2virt_local(p, n);
+}
