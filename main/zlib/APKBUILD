# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=zlib
pkgver=1.3.2
pkgrel=2
pkgdesc="A compression/decompression Library"
arch="all"
license="Zlib"
url="https://zlib.net/"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="https://zlib.net/fossils/zlib-$pkgver.tar.gz
	CVE-2026-85091.patch
	svm-runtime-init.patch
	"

if [ "${SWMMU_ONLY:-0}" = 1 ] || [ "${SVM_ONLY:-0}" = 1 ]; then
	pkgname="$pkgname-nommu"
	pkgdesc="zlib built for an instrumented NOMMU guest"
	arch="x86_64"
	subpackages=""
	depends=""
	provides="zlib=$pkgver-r$pkgrel"
	replaces="zlib"
	builddir="$srcdir/zlib-$pkgver"
fi

# secfixes:
#   1.3.2-r1:
#     - CVE-2026-85091
#   1.3.2-r0:
#     - CVE-2026-22184
#     - CVE-2026-27171
#   1.2.12-r2:
#     - CVE-2022-37434
#   1.2.11-r4:
#     - CVE-2018-25032
#   0:
#     - CVE-2023-45853
#     - CVE-2023-6992
#     - CVE-2026-22184

build() {
	# we trade size for a little more speed.
	export CFLAGS="$CFLAGS -O2"
	if [ "${SVM_ONLY:-0}" = 1 ]; then
		. "$startdir/../../scripts/svm-profile.sh"
		svm_guest_profile || return 1
		# zlib initializes these descriptors at runtime when constant data
		# pointers cannot retain their SVM address identity.
		export CFLAGS="$CFLAGS -DNO_INIT_GLOBAL_POINTERS"
	elif [ "${SWMMU_ONLY:-0}" = 1 ]; then
		. "$startdir/../../scripts/swmmu-profile.sh"
		swmmu_guest_profile || return 1
	fi
	if [ "${SWMMU_ONLY:-0}" = 1 ] || [ "${SVM_ONLY:-0}" = 1 ]; then
		CFLAGS="$CFLAGS -fno-lto" \
		CC="$CC" \
		CHOST="$CHOST" ./configure \
			--prefix=/usr \
			--shared \
			--disable-crcvx
		make
		return
	fi
	CHOST="$CHOST" ./configure \
		--prefix=/usr \
		--shared \
		--disable-crcvx
	make
}

check() {
	if [ "${SWMMU_ONLY:-0}" = 1 ] || [ "${SVM_ONLY:-0}" = 1 ]; then
		# The instrumented target needs a UML NOMMU ABI and cannot
		# execute as an Alpine host build tool. Test it in the guest instead.
		return 0
	fi
	make check
}

package() {
	make install DESTDIR="$pkgdir"
	if [ "${SWMMU_ONLY:-0}" = 1 ] || [ "${SVM_ONLY:-0}" = 1 ]; then
		local _nommu_sysroot
		if [ "${SVM_ONLY:-0}" = 1 ]; then
			_nommu_sysroot=$SVM_SYSROOT
		else
			_nommu_sysroot=$SWMMU_SYSROOT
		fi
		depends="musl-nommu"
		make install DESTDIR="$_nommu_sysroot"
		install -d "$_nommu_sysroot/usr/lib/pkgconfig"
		cat > "$_nommu_sysroot/usr/lib/pkgconfig/zlib.pc" <<-EOF
		prefix=/usr
		exec_prefix=\${prefix}
		libdir=\${prefix}/lib
		includedir=\${prefix}/include

		Name: zlib
		Description: zlib compression library
		Version: $pkgver
		Libs: -L\${libdir} -lz
		Cflags: -I\${includedir}
		EOF
		rm -rf "$pkgdir"/usr/include "$pkgdir"/usr/share \
			"$pkgdir"/usr/lib/libz.a "$pkgdir"/usr/lib/libz.so \
			"$pkgdir"/usr/lib/pkgconfig
	fi
}

