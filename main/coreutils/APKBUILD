# A separately installable instrumented coreutils package
# for the SWMMU NOMMU guest. Retain the upstream package source and build.
if [ "${SWMMU_ONLY:-0}" = 1 ]; then
	arch="x86_64"
	subpackages="$pkgname-nommu::x86_64"
	makedepends="bash"
	install=
fi

nommu() {
	[ "${SWMMU:-0}" = 1 ] || {
		error "Set SWMMU=1 to build the instrumented coreutils NOMMU package"
		return 1
	}
	pkgdesc="Core file, text and shell utilities built for SWMMU NOMMU"
	depends="musl-nommu"
	amove usr/bin usr/libexec/coreutils
}
