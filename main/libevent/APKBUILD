# Contributor: Sergei Lukin <sergej.lukin@gmail.com>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=libevent
pkgver=2.1.13
_pkgver=$pkgver-stable
pkgrel=0
pkgdesc="An event notification library"
url="https://libevent.org/"
arch="all"
license="BSD-3-Clause"
depends_dev="python3"
makedepends="$depends_dev openssl-dev>3"
subpackages="$pkgname-static $pkgname-dev"
source="https://github.com/libevent/libevent/releases/download/release-$_pkgver/libevent-$_pkgver.tar.gz"
builddir="$srcdir/$pkgname-$_pkgver"

# secfixes:
#   2.1.8-r0:
#     - CVE-2016-10195
#     - CVE-2016-10196
#     - CVE-2016-10197

prepare() {
	default_prepare

	sed -i '1s|^#!/usr/bin/env python$|#!/usr/bin/python3|' event_rpcgen.py
	# help provides tracing work out correctly
	sed -i -e "s/@VERSION@/$pkgver-r$pkgrel/" *.pc.in
}

build() {
	if [ "${SVM_ONLY:-0}" = 1 ]; then
		. "$startdir/../../scripts/svm-profile.sh"
		svm_guest_profile || return 1
		local _svm_cc="$CC"
		CC="${REALGCC:-gcc}" ./configure \
			--build="$CBUILD" \
			--host=x86_64-linux-musl \
			--prefix=/usr \
			--sysconfdir=/etc \
			--disable-openssl \
			--disable-libevent-regress || return 1
		make CC="$_svm_cc"
		return
	fi
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-libevent-regress
	make
}

check() {
	make -j1 check
}

package() {
	make -j1 DESTDIR=$pkgdir install
	if [ "${SVM_ONLY:-0}" = 1 ]; then
		make -j1 DESTDIR="$SVM_SYSROOT" install
	fi
}

if [ "${SVM_ONLY:-0}" = 1 ]; then
	pkgname="$pkgname-nommu"
	pkgdesc="$pkgdesc (instrumented SVM guest)"
	arch="x86_64"
	subpackages="$pkgname-dev"
	makedepends="python3"
	depends="musl-nommu"
	options="$options !check !tracedeps"
fi

dev() {
	replaces="libevent"
	default_dev
	mv "$pkgdir"/usr/bin "$subpkgdir"/usr/
}

static() {
	depends=""
	pkgdesc="$pkgdesc (static libraries)"
	mkdir -p "$subpkgdir"/usr/lib
	mv "$pkgdir"/usr/lib/*.a "$subpkgdir"/usr/lib
}

sha512sums="5c7a1b9f48087258f49653ecb4ce24d7015a9ef4015ad6ffa910a101d5bd37c657c26fc948eaae30c4abeb54d1cda33290878161bd73bb50e4e85f7dc667c36d  libevent-2.1.13-stable.tar.gz"
